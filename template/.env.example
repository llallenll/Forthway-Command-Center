# Copy to .env.local for local development.
#
# On a deployed site the Command Center never overwrites .env files — they are
# in its "never touched" list — so set the real values once on the server and
# they survive every deploy and every rollback.

# `next start` reads this. The Command Center passes it in from the site's port,
# so you only need it locally.
# PORT=3000
